        <mxCell id="JaZJ1dat7MXWys5UXU-u-3" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Notiz - Provisorisch&lt;/h1&gt;&lt;div&gt;Veränderungen werden im Laufe der Arbeit im Diagramm hinzugefügt&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Genauere Angaben zu den Datentypen steht noch nicht ganz fest. Jedoch sind alle PKs INT&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
